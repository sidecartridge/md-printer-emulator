# A reboot loses no job and leaves no half-written PDF: the RP restarts (a
# cold reset power-cycles the Multi-device) while PRFILES prints, so the job
# is still under its temporary name; at boot it is closed and rendered. Job 1
# is an empty job with a PDF a reboot left unfinished (both put on the card),
# so the print is job 2: at boot the unfinished PDF is deleted and job 1,
# which prints no page, leaves no file. NEXT_JOB, not stored before the
# reset, still says 1: the next job still takes number 3. No job's bytes are
# left.
@disk-a tools/dev/builds/disks/escp.st
text "Machine +: (ST|STE|Mega STE), TOS" 1500
key e
wait 100
cardput PRINTER/00000001.PDT
cardput PRINTER/00000001.PRN
key 0x01
wait 900
key 0x39
newlog "printer: job 00000002 opened" 1500
reset cold
newlog "Cartridge image in RAM verified" 1500
log "pages: job 00000001's PDF cut short by a reboot, deleted \(0\)" 1500
log "pages: job 00000002 cut short by a reboot, closed \(0\)" 1500
log "pages: job 00000001 rendered, 0 pages, PDF 0 bytes" 1500
log "pages: job 00000002 rendered, [1-3] pages, PDF [0-9]+ bytes" 1500
cardnone PRINTER/00000001.*
cardnone PRINTER/*.PDT
cardnone PRINTER/*.TMP
cardnone PRINTER/*.PRN
text "Machine +: (ST|STE|Mega STE), TOS" 500
key e
wait 100
key 0x01
wait 900
key 0x39
log "pages: job 00000003 rendered, 3 pages, PDF 32366 bytes" 3000
cardsame PRINTER/00000003.pdf tools/dev/builds/disks/escp-expected.pdf
cardnone PRINTER/*.PRN
