# Print jobs on the card: each time PRFILES prints our ESC/P pages (escp.st's
# AUTO folder, at every boot) is one job, a file in PRINTER/ numbered from the
# NEXT_JOB setting, under its final name once the RP's idle timeout has
# passed. A warm reset gives the second job; a cold reset restarts the RP,
# whose NEXT_JOB setting, stored in flash as job 2 ended, is 3: the third job
# is 00000003.PRN. Each file equals the two pages byte for byte.
@disk-a tools/dev/builds/disks/escp.st
text "Atari +: (ST|STE|Mega STE), TOS" 1500
key f
key 0x1c
wait 100
key 0x01
wait 900
key 0x39
cardfile PRINTER/00000001.PRN 2938 3000
cardsame PRINTER/00000001.PRN tools/dev/builds/disks/escp-expected.prn
reset warm
newlog "Setting shared variable 1 to" 1500
wait 100
key 0x01
wait 900
key 0x39
cardfile PRINTER/00000002.PRN 2938 3000
cardsame PRINTER/00000002.PRN tools/dev/builds/disks/escp-expected.prn
reset cold
newlog "Cartridge image in RAM verified" 1500
newlog "Setting shared variable 1 to" 1500
text "Atari +: (ST|STE|Mega STE), TOS" 500
key s
key 0x1c
type print
key 0x1c
text "NEXT_JOB .INT.: 3" 300
key m
key 0x1c
text "Atari +: (ST|STE|Mega STE), TOS" 300
key f
key 0x1c
wait 100
key 0x01
wait 900
key 0x39
cardfile PRINTER/00000003.PRN 2938 3000
cardsame PRINTER/00000003.PRN tools/dev/builds/disks/escp-expected.prn
